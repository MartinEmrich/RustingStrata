#version 460
layout(local_size_x = 1) in;
#include "common.glsl"
layout(buffer_reference, std430, buffer_reference_align = 8) buffer U64 { uvec2 v[]; };
layout(push_constant) uniform P { U64 o; } p;
layout(constant_id = 1) const uint ITERS = 250000;

// STRATA_PIPE_SPIN: burn about ITERS cycles on one lane. The pipelined decode forward appends this to each
// layer's submission: the worker's answer leaves the GPU idle for about a millisecond between the 0.2 ms
// submissions, and every submission start after an idle gap pays milliseconds of Polaris wake-up latency.
// The accumulator chain depends on every iteration, so the loop cannot be folded away; the store never runs.
void main() {
    uint a = 1u;
    for (uint i = 0; i < ITERS; i++) a = a * 1664525u + 1013904223u;
    if (a == 0xdeadbeefu) p.o.v[0] = uvec2(a, a);
}
